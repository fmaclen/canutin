{
	"name": "canutin-next",
	"version": "2.0.0-next.82",
	"devDependencies": {
		"@canutin/svelte-currency-input": "^1.1.1",
		"@date-fns/utc": "^2.1.1",
		"@eslint/compat": "^1.2.5",
		"@eslint/js": "^9.18.0",
		"@ianvs/prettier-plugin-sort-imports": "^4.7.0",
		"@inlang/paraglide-js": "^2.0.0",
		"@internationalized/date": "^3.8.1",
		"@lucide/svelte": "^0.515.0",
		"@playwright/test": "^1.49.1",
		"@semantic-release/git": "^10.0.1",
		"@sveltejs/adapter-auto": "^6.0.0",
		"@sveltejs/adapter-node": "^5.5.4",
		"@sveltejs/kit": "^2.66.0",
		"@sveltejs/vite-plugin-svelte": "^6.0.0",
		"@tailwindcss/vite": "^4.0.0",
		"@types/bun": "^1.2.21",
		"@types/d3-hierarchy": "^3.1.7",
		"@types/d3-scale": "^4.0.9",
		"@types/d3-shape": "^3.1.7",
		"@types/node": "^22.9.0",
		"bits-ui": "^2.11.0",
		"clsx": "^2.1.1",
		"d3-hierarchy": "^3.1.2",
		"d3-scale": "^4.0.2",
		"d3-shape": "^3.2.0",
		"date-fns": "^4.1.0",
		"eslint": "^9.18.0",
		"eslint-config-prettier": "^10.0.1",
		"eslint-plugin-svelte": "^3.0.0",
		"globals": "^16.0.0",
		"layerchart": "2.0.1",
		"mode-watcher": "^1.0.8",
		"pocketbase": "^0.26.8",
		"pocketbase-typegen": "^1.3.3",
		"prettier": "^3.4.2",
		"prettier-plugin-svelte": "^3.3.3",
		"prettier-plugin-tailwindcss": "^0.6.11",
		"semantic-release": "^25.0.5",
		"svelte": "^5.0.0",
		"svelte-check": "^4.0.0",
		"svelte-sonner": "^1.0.5",
		"tailwind-merge": "^3.3.1",
		"tailwind-variants": "^3.1.1",
		"tailwindcss": "^4.0.0",
		"tw-animate-css": "^1.3.8",
		"typescript": "^5.0.0",
		"typescript-eslint": "^8.20.0",
		"vite": "^7.0.4"
	},
	"private": true,
	"scripts": {
		"dev": "PUBLIC_DEMO_ENABLED=true bun run vite dev",
		"build": "bun run vite build",
		"preview": "bun run vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "bun run prettier --write .",
		"lint": "bun run prettier --check . && bun run eslint .",
		"test": "playwright test",
		"verify": "bun run lint && bun run check && bun run build",
		"quality": "bun run format && bun run eslint . && bun run check",
		"pb": "IS_DEV=true PUBLIC_DEMO_ENABLED=true bun scripts/pb-server.ts",
		"pb:import": "bun scripts/pb-import.ts",
		"pb:reset": "bun scripts/pb-reset.ts",
		"worktree": "bun scripts/worktree.ts",
		"worktree:create": "bun scripts/worktree.ts create",
		"worktree:list": "bun scripts/worktree.ts list",
		"worktree:remove": "bun scripts/worktree.ts remove",
		"worktree:sweep": "bun scripts/worktree.ts sweep"
	},
	"type": "module"
}
